# Скопируйте этот файл в .env и подставьте свои значения.
# Нужен реальный ключ хотя бы одного провайдера; провайдеры с пустым ключом
# или ключом-заглушкой в интерфейсе не показываются.

# Anthropic Claude
CLAUDE_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-3-haiku-20240307

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# NVIDIA NIM (OpenAI-совместимый API)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Общие настройки
# Спецсимволы в пароле БД указываются в percent-encoding (например, @ -> %40)
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/claude_anonimizer
LOG_LEVEL=INFO
# Провайдер по умолчанию в веб-интерфейсе: claude | openai | nvidia
DEFAULT_PROVIDER=claude

# Bitrix24: входящий вебхук с правом чтения CRM (необязательно)
BITRIX24_WEBHOOK_URL=
